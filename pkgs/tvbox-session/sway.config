# tvbox sway config: a kiosk. No bar, no decorations, every app fullscreen,
# one workspace per app. User additions: ~/.config/tvbox/sway.d/*.conf

default_border none
default_floating_border none
focus_follows_mouse no
mouse_warping none
# inputd shows the cursor in mouse mode (hide_cursor 0) and hides it again.
seat * hide_cursor 100
xwayland disable

output * bg #101418 solid_color
output * adaptive_sync off
output * power on

# Every window fullscreen.
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable

# Development escape hatches (a keyboard is only for debugging; the controller
# never produces these combos).
bindsym Ctrl+Alt+Return exec foot
bindsym Ctrl+Alt+BackSpace exit

# Hand the environment to systemd/D-Bus and start the user services.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE LIBVA_DRIVER_NAME
exec systemctl --user start tvbox-session.target
exec_always tvbox-display apply

# Phase 1 placeholder until the launcher exists (Phase 3).
exec tvbox-status

include /etc/tvbox/sway.d/*.conf
include ~/.config/tvbox/sway.d/*.conf
