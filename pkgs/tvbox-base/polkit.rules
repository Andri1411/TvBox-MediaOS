// tvbox: the tv user's session services (the hub) set up Wi-Fi from the TV
// and the phone. NetworkManager's own rules only allow that from an active
// login session, and the hub runs as a user service outside it. Only the
// actions Wi-Fi settings need; nothing else is granted.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (subject.user == "tv" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
