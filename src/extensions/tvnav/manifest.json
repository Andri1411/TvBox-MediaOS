{
  "manifest_version": 3,
  "name": "tvbox navigation",
  "description": "D-pad navigation for desktop sites on the tvbox media PC.",
  "version": "1.0",
  "key": "",
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["*://*.netflix.com/*"], "js": ["sites/netflix.js"], "run_at": "document_start" },
    { "matches": ["*://*.disneyplus.com/*"], "js": ["sites/disney.js"], "run_at": "document_start" },
    { "matches": ["*://*.primevideo.com/*", "*://*.amazon.com/gp/video/*"], "js": ["sites/prime.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["nav.js"], "css": ["nav.css"], "run_at": "document_start" }
  ]
}
