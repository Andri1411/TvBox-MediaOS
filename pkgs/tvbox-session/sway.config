# tvbox sway config: a kiosk. No bar, no decorations, every app fullscreen,
# one workspace per app. User additions: ~/.config/tvbox/sway.d/*.conf

default_border none
default_floating_border none
focus_follows_mouse no
mouse_warping none
# inputd shows the cursor in mouse mode (hide_cursor 0) and hides it again.
seat * hide_cursor 100
xwayland disable

output * bg #101418 solid_color
output * adaptive_sync off
output * power on

# Every window fullscreen.
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable

# Development escape hatches (a keyboard is only for debugging; the controller
# never produces these combos).
bindsym Ctrl+Alt+Return exec foot
bindsym Ctrl+Alt+BackSpace exit

# Keyboards are not handled by tvbox-inputd (their keys go straight to the
# focused app), so they get their own way into the system menu. While the
# menu is open the hub switches sway to this mode, where the keys that would
# otherwise reach the app drive the menu instead.
bindsym Ctrl+Alt+m exec tvbox-ctl action ui:system_menu
bindsym Menu exec tvbox-ctl action ui:system_menu
bindsym Ctrl+Alt+h exec tvbox-ctl action ui:home
mode "tvbox-ui" {
    bindsym Up exec tvbox-ctl button up
    bindsym Down exec tvbox-ctl button down
    bindsym Left exec tvbox-ctl button left
    bindsym Right exec tvbox-ctl button right
    bindsym Return exec tvbox-ctl button ok
    bindsym Escape exec tvbox-ctl button back
    bindsym BackSpace exec tvbox-ctl button back
    bindsym Ctrl+Alt+m exec tvbox-ctl action ui:system_menu
    bindsym Menu exec tvbox-ctl action ui:system_menu
    bindsym Ctrl+Alt+h exec tvbox-ctl action ui:home
}

# Hand the environment to systemd/D-Bus and start the user services.
# (one command: the services must not start before they can see the display)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE LIBVA_DRIVER_NAME && systemctl --user start tvbox-session.target
exec_always tvbox-display apply

# Phase 1 placeholder until the launcher exists (Phase 3).
exec tvbox-status

include /etc/tvbox/sway.d/*.conf
include ~/.config/tvbox/sway.d/*.conf
