#!/bin/bash
# Session entry point (started by greetd as the tv user). Restarts sway if it
# exits, so a compositor crash or "restart session" never leaves a login prompt.
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export LIBVA_DRIVER_NAME=iHD
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
# In a VM (QEMU testing), use wlroots' pixman CPU renderer: Mesa's llvmpipe
# crashed sway and lost glyphs under QEMU's CPU emulation, and virtio-gpu
# exposes a render node even without 3D, so that can't be the test. The real
# box is never a VM and keeps the GLES renderer. Override in
# /etc/tvbox/session.conf (e.g. WLR_RENDERER=gles2 with QEMU_GL=1).
if systemd-detect-virt --vm --quiet; then
    export WLR_RENDERER=pixman
fi
# shellcheck source=/dev/null
if [[ -r /etc/tvbox/session.conf ]]; then set -a; . /etc/tvbox/session.conf; set +a; fi

config=/usr/share/tvbox/sway/config
fails=0
# "Restart session" in the system menu creates this flag and makes sway exit
# cleanly; without the flag a clean exit is a logout.
restart_flag=${XDG_RUNTIME_DIR:-/tmp}/tvbox/restart-session
while :; do
    rm -f "$restart_flag"
    start=$SECONDS
    if sway --config "$config" >>"${XDG_RUNTIME_DIR:-/tmp}/sway.log" 2>&1; then
        [[ -e $restart_flag ]] || exit 0
        continue
    fi
    # sway exited with an error: retry, but stop hammering after rapid crashes
    # so greetd's fallback can take over.
    if ((SECONDS - start < 10)); then ((++fails)); else fails=0; fi
    ((fails >= 5)) && exit 1
    sleep 1
done
